{
  "name": "lather",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "check:links": "node scripts/check-links.mjs",
    "build:cf": "STATIC_EXPORT=1 next build && node scripts/cloudflare.mjs",
    "build:cf:preview": "STATIC_EXPORT=1 next build && node scripts/cloudflare.mjs --preview",
    "deploy:cf": "npm run build:cf && wrangler deploy",
    "deploy:cf:preview": "npm run build:cf:preview && wrangler deploy --name lather-preview"
  },
  "dependencies": {
    "framer-motion": "^12.43.0",
    "next": "^16.1.6",
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.1.6",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
