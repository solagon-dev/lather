// Cloudflare Workers: the static site in out/, behind a small Worker that does
// the redirects. Build with `npm run build:cf` (production) or
// `npm run build:cf:preview` (the noindex test link) before deploying.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lather",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
